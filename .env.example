# Copy to .env.local (and add the same values in your hosting dashboard).

# Formspree form ID: the last part of https://formspree.io/f/XXXXXXXX
# While empty, the form opens the visitor's email app instead.
VITE_FORMSPREE_ID=

# Booking link shown after a successful enquiry, e.g. https://calendly.com/your-name/20min
# While empty, the button is hidden.
VITE_BOOKING_URL=
